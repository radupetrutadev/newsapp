# Copy to .env.local and fill in to switch Pulse from demo mode to Supabase.
# Find these in your Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Older projects can use the legacy anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used for metadata and auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- News ingestion (/api/ingest) and account deletion ------------------------
# Server-only secret key, used to write fetched stories and to delete accounts
# when readers ask (Project Settings → API keys).
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Older projects can use the legacy service_role key instead:
# SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Browser push notifications (optional) ------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never prefix it with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
# How push services can reach you: mailto:you@example.com or your site URL.
# VAPID_SUBJECT=

# --- Weekly email digest (optional, /api/digest) ------------------------------
# Server-only Resend API key (resend.com), and a sender on a domain verified there.
RESEND_API_KEY=
DIGEST_FROM=Pulse <digest@yourdomain.com>
